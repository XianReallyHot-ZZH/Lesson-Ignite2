<?xml version="1.0" encoding="UTF-8"?>

<!--
  Lesson-Ignite2 根聚合 POM。
  对应 vendor: vendors/ignite/pom.xml（apache-ignite 聚合器，2.18.0 默认构建 39 模块）。
  复刻仅镜像内核闭包的 8 个模块；indexing/calcite/urideploy 随各自课弧再加入。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.lessonignite</groupId>
        <artifactId>ignite-parent</artifactId>
        <version>2.18.0</version>
        <relativePath>parent/pom.xml</relativePath>
    </parent>

    <artifactId>lesson-ignite</artifactId>
    <packaging>pom</packaging>

    <modules>
        <!-- 构建基建（镜像 vendor 的 parent / parent-internal / bom 三层） -->
        <module>parent</module>
        <module>parent-internal</module>
        <module>modules/bom</module>

        <!-- 内核闭包（ADR 0003：镜像 2.18 拆分、provided+shade 协议） -->
        <module>modules/commons</module>
        <module>modules/binary/api</module>
        <module>modules/binary/impl</module>
        <module>modules/unsafe</module>
        <module>modules/core</module>
    </modules>
</project>
